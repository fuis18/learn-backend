# ---- Stage 1: build ----
FROM docker.io/library/golang:1.27-alpine AS build

WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/app .

# ---- Stage 2: runtime ----
FROM scratch

COPY --from=build /out/app /app/server

WORKDIR /app

USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["/app/server"]
