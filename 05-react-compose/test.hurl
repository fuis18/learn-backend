# Fase 5: React + Nginx

# --- The backend is alive (directly, port 8080) ---
GET http://localhost:8080/health
HTTP/1.1 200
[Asserts]
header "Content-Type" == "text/plain; charset=utf-8"
body == "OK\n"

# --- Nginx serves the React SPA built by Vite ---
GET http://localhost:3000/
HTTP/1.1 200
[Asserts]
header "Content-Type" == "text/html"
body contains "<div id=\"root\"></div>"

# Asset names are hashed, so capture them from index.html instead of hardcoding
[Captures]
app_js: xpath "string(//script[@type='module']/@src)"
app_css: xpath "string(//link[@rel='stylesheet']/@href)"

GET http://localhost:3000{{app_js}}
HTTP/1.1 200
[Asserts]
header "Content-Type" == "application/javascript"

GET http://localhost:3000{{app_css}}
HTTP/1.1 200
[Asserts]
header "Content-Type" == "text/css"

# --- SPA fallback: unknown routes answer index.html for React Router ---
GET http://localhost:3000/products/42
HTTP/1.1 200
[Asserts]
header "Content-Type" == "text/html"
body contains "<div id=\"root\"></div>"

# --- Only /api is proxied: unknown API routes reach Go, not the SPA ---
GET http://localhost:3000/api/nope
HTTP/1.1 404
[Asserts]
body == "404 page not found\n"

# --- The API through the Nginx reverse proxy: the store starts empty ---
GET http://localhost:3000/api/products
HTTP/1.1 200
[Asserts]
header "Content-Type" == "application/json; charset=utf-8"
body contains "[]"

# --- Post creates and answers 201 + Location ---
POST http://localhost:3000/api/products
{
    "name": "Teclado",
    "price": 50.5
}
HTTP/1.1 201
[Asserts]
header "Location" == "/api/products/1"
jsonpath "$.id" == 1
jsonpath "$.name" == "Teclado"
# code is generated by the sequence: only check it is numeric
jsonpath "$.code" matches "^[0-9]+$"

# --- Get list and Get one ---
GET http://localhost:3000/api/products
HTTP/1.1 200
[Asserts]
jsonpath "$[0].name" == "Teclado"

GET http://localhost:3000/api/products/1
HTTP/1.1 200
[Asserts]
jsonpath "$.price" == 50.5

# --- Bad id and missing product ---
GET http://localhost:3000/api/products/abc
HTTP/1.1 400
[Asserts]
jsonpath "$.error" == "id must be a positive integer"

GET http://localhost:3000/api/products/99
HTTP/1.1 404
[Asserts]
jsonpath "$.error" == "product not found"

# --- Patch changes only the sent fields ---
PATCH http://localhost:3000/api/products/1
{
    "price": 60
}
HTTP/1.1 200
[Asserts]
jsonpath "$.price" == 60
jsonpath "$.name" == "Teclado"

# Empty patch is rejected
PATCH http://localhost:3000/api/products/1
{}
HTTP/1.1 400
[Asserts]
jsonpath "$.error" == "no fields to update (send code, name and/or price)"

# --- Unknown fields are rejected ---
POST http://localhost:3000/api/products
{
    "nme": "Ratón"
}
HTTP/1.1 400
[Asserts]
jsonpath "$.error" contains "unknown field"

# --- Validations: price and code ---
POST http://localhost:3000/api/products
{
    "name": "Barato",
    "price": -1
}
HTTP/1.1 400
[Asserts]
jsonpath "$.error" == "price must be >= 0"

POST http://localhost:3000/api/products
{
    "code": "abc",
    "name": "Caro"
}
HTTP/1.1 400
[Asserts]
jsonpath "$.error" == "code must contain only digits"

# --- Explicit codes are unique (409 on duplicates) ---
POST http://localhost:3000/api/products
{
    "code": "999001",
    "name": "Único"
}
HTTP/1.1 201
[Asserts]
jsonpath "$.code" == "999001"

POST http://localhost:3000/api/products
{
    "code": "999001",
    "name": "Duplicado"
}
HTTP/1.1 409
[Asserts]
jsonpath "$.error" == "code already exists"

# --- Delete answers 204 and the product is gone ---
DELETE http://localhost:3000/api/products/1
HTTP/1.1 204

DELETE http://localhost:3000/api/products/1
HTTP/1.1 404
[Asserts]
jsonpath "$.error" == "product not found"
