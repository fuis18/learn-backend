# --- STAGE 1: Frontend Construction (React + Vite) ---
FROM docker.io/library/node:24-alpine AS builder

WORKDIR /app

# Compile dependencies and source code
COPY frontend/package.json frontend/pnpm-lock.yaml* frontend/package-lock.json* ./
RUN corepack enable && (pnpm install --frozen-lockfile || pnpm install)

COPY frontend/ ./
RUN pnpm build

# --- STAGE 2: Web Server and Reverse Proxy (Nginx) ---
FROM docker.io/library/nginx:alpine-slim

# We copy the compiled files from the Node stage to the Nginx root directory
COPY --from=builder /app/dist /usr/share/nginx/html

# We copy our custom Nginx configuration
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
